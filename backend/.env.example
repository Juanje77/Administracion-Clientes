# Cuenta de servicio de Firebase: JSON completo en una línea, o ruta al archivo .json
FIREBASE_SERVICE_ACCOUNT="./cuenta-de-servicio.json"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
PORT=3001
# Nombre del bucket de Firebase Storage (documentos adjuntos), ej. mi-proyecto.firebasestorage.app
FIREBASE_STORAGE_BUCKET=""

# Avisos por email (Gmail con "contraseña de aplicación" u otro SMTP)
SMTP_USER=""
SMTP_PASS=""
ESTUDIO_NOMBRE="Estudio Contable"
APP_URL="http://localhost:5173"
# Protege el envío automático diario (texto largo aleatorio)
CRON_SECRET=""
